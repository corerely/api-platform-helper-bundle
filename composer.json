{
    "name": "corerely/api-platform-helper-bundle",
    "description": "Api Platform helper filters etc..",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Corerely\\ApiPlatformHelperBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Corerely\\ApiPlatformHelperBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Andrii Oprysko",
            "email": "anjey.link@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "api-platform/doctrine-orm": "^4.0",
        "api-platform/symfony": "^4.0",
        "symfony/http-kernel": "^8.0",
        "doctrine/orm": "^3.6"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.18",
        "slevomat/coding-standard": "^8.0",
        "phpunit/phpunit": "^11.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/phpunit-bridge": "^8.0",
        "symfony/property-access": "^8.0",
        "symfony/yaml": "^8.0",
        "symfony/uid": "^8.0",
        "zenstruck/foundry": "^2.0",
        "matthiasnoback/symfony-dependency-injection-test": "^6.0",
        "symfony/http-client": "^8.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "allow-plugins": true
    }
}
